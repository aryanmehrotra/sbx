{
  "version": 1,
  "services": {
    "postgres": {
      "image": "postgres:16-alpine@sha256:44c4ee9810eff91f7eab4d822642e01115b1a9eccce4bcbdde7604752d68eac6",
      "ports": [5432],
      "health": "pg_isready -U app -d app",
      "env": { "POSTGRES_USER": "app", "POSTGRES_PASSWORD": "app", "POSTGRES_DB": "app" },
      "volume": "/var/lib/postgresql/data"
    },
    "clickhouse": {
      "image": "clickhouse/clickhouse-server:24.3-alpine@sha256:c3f166f4a80098480463d897a63f6867d24e3a7661fc1fe72e889788115a25f1",
      "ports": [9000, 8123],
      "health": "clickhouse-client -q 'SELECT 1'",
      "volume": "/var/lib/clickhouse",
      "files": { "clickhouse-low-mem.xml": "/etc/clickhouse-server/config.d/low-mem.xml" },
      "optional": true
    }
  },
  "exports": {
    "DATABASE_PORT": "postgres:5432",
    "CLICKHOUSE_PORT": "clickhouse:9000",
    "CLICKHOUSE_HTTP_PORT": "clickhouse:8123"
  }
}
