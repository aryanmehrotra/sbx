<!--
  ClickHouse with its caches bounded.

  Two settings that were in an earlier version of this file are deliberately absent:
  max_thread_pool_size and background_pool_size. ClickHouse 24.3 exits during startup when
  either is set here - silently, logging "Shutting down storages" with no error - and the
  container then looks like a service that never came up.

  Be aware of what this does and does not buy. Measured on a fresh idle server, tuned and
  untuned are within 2 MB of each other: an idle ClickHouse is about 200 MB either way. The
  caps matter under load, where the mark cache would otherwise grow toward its 5 GiB default.
  Do not expect them to shrink an idle sandbox.
-->
<clickhouse>
    <max_server_memory_usage>536870912</max_server_memory_usage>
    <mark_cache_size>67108864</mark_cache_size>
    <index_mark_cache_size>16777216</index_mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <compiled_expression_cache_size>0</compiled_expression_cache_size>
    <max_concurrent_queries>20</max_concurrent_queries>
</clickhouse>
